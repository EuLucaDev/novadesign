<?xml version="1.0" encoding="utf-8"?>
<!--
  NovaDesign MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build novadesign.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.novadesign` owned by
  NovaDesign, and NovaDesign offered under "Open with" for IDML (without taking over the user's
  default app for it).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="NovaDesign"
      Manufacturer="Nova Foods"
      Version="$(var.Version)"
      UpgradeCode="56CC4B14-5F31-56E9-B2CC-ACCFFAD61DDE"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="NovaDesign page layout and publishing" Manufacturer="Nova Foods" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of NovaDesign is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="NovadesignIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="NovadesignIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://workflowind.agcunae.com/apps/novadesign" />
    <Property Id="ARPURLUPDATEINFO" Value="https://workflowind.agcunae.com/apps/novadesign" />
    <Property Id="ARPHELPLINK" Value="https://workflowind.agcunae.com/inbox" />

    <!-- Shared native setup UI, including install/uninstall completion. -->

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="NovaDesign" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="NovaDesign" Level="1">
      <ComponentGroupRef Id="NovadesignFiles" />
      <ComponentGroupRef Id="CraftInstallerSettings" />
    </Feature>
    <!-- Shared full UI; app installation policy remains below. -->
    <UIRef Id="CraftInstallerUI" />
  </Package>

  <Fragment>
    <ComponentGroup Id="NovadesignFiles" Directory="INSTALLFOLDER">
      <Component Id="NovadesignApp" Guid="858B735E-EB47-577A-B5E0-DDC0EBDB7810">
        <File Id="NovadesignExe" Source="$(var.BinDir)\novadesign.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="NovaDesign"
              Description="NovaDesign page layout and publishing" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="NovadesignIcon.ico" IconIndex="0" />
        </File>

        <!-- .novadesign: NovaDesign's own format; NovaDesign is its default app. -->
        <ProgId Id="Novadesign.Document" Description="NovaDesign Document" Icon="NovadesignExe" IconIndex="0">
          <Extension Id="novadesign" ContentType="application/x-novadesign">
            <Verb Id="open" Command="Open" TargetFile="NovadesignExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- IDML: offered under "Open with", never forced as the default. -->
        <ProgId Id="Novadesign.Idml" Description="IDML Document" Icon="NovadesignExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Novadesign.Idml\shell\open\command" Value="&quot;[#NovadesignExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.idml\OpenWithProgids" Name="Novadesign.Idml" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "novadesign"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novadesign.exe" Name="FriendlyAppName" Value="NovaDesign" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novadesign.exe\shell\open\command" Value="&quot;[#NovadesignExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novadesign.exe\SupportedTypes" Name=".novadesign" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novadesign.exe\SupportedTypes" Name=".idml" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\novadesign.exe" Value="[#NovadesignExe]" Type="string" />
      </Component>

      <Component Id="NovadesignCli">
        <File Id="NovadesignCliExe" Source="$(var.BinDir)\novadesign-cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="NovaFoodsLegalNotice">
        <File Id="NovaFoodsLegalNoticeFile" Source="$(sys.SOURCEFILEDIR)..\..\NOTICE" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
